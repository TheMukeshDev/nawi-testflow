# ═══════════════════════════════════════════════════════════════
# NAWI Sahayak — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.

# ── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (FastAPI) ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nawi_testflow

# ── Optional: AI Assistance (on-demand Gemini) ─────────────────
# Rule-based explanations always work without these. Gemini "Enhance
# with AI" needs a key — set it here OR from Settings UI (user's own
# key at /settings, or admin global key at /admin/settings).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_ASSISTANCE_ENABLED=true

# ── Development ─────────────────────────────────────────────
NODE_ENV=development
